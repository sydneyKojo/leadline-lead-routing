PORT=3200
# Shared secret the form or n8n must send in the X-Webhook-Secret header.
WEBHOOK_SECRET=change-me
# Storage: "postgres" (recommended when deployed; uses DATABASE_URL), "airtable", or "file" (data/*.json, local demos).
STORE=file
DATABASE_URL=postgres://localhost:5432/leadline
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
# Optional. Leave blank to log alerts and emails to the console instead of sending.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
FOLLOW_UP_FROM=Sales <sales@example.com>

# Password for the dashboard at /app.
ADMIN_TOKEN=change-me
# Set to true only behind a reverse proxy you control (uses X-Forwarded-For for rate limiting).
TRUST_PROXY=false
